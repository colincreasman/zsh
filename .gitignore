# Machine-specific config (work paths, proxies, secrets)
zsh/local.zsh

# Plugins cloned by install.sh
plugins/

# Raw package list written by capture.sh; Brewfile is the source of truth
Brewfile.generated

# Backups made by install.sh
*.bak-*

# Personal/local files not for version control
CLAUDE.md

# Ignore  ackup files.
*~
# Ignore Vim swap files.
.*.swp
# macOS-specific excludes
.DS_Store
._.DS_Store
.AppleDouble
.LSOverride

# Generated build artifacts
# makefile
*.mk
*.opt
*.pp
*.xml
*.ninja_log
*.ninja

# Python Tools for Visual Studio (PTVS)
__pycache__/
**/*secret.py
**/*poetry.toml
