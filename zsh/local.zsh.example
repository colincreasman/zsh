# local.zsh - machine-specific config. NOT tracked in git.
#
# Copy to local.zsh and edit. Sourced last by .zshrc, so anything here wins.
# Good candidates: work paths, corporate proxies, per-machine SDKs, secrets.

# --- Example: project locations + shortcuts ---
# export MYPROJ=~/src/myproject
# alias mp='cd $MYPROJ'

